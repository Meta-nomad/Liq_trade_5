DATA_MODE=live
PAPER_BALANCE=1000
# Mount a persistent volume at /data before setting this path.
FLOW_DB_PATH=/data/flow_v050.db
DASHBOARD_TOKEN=replace-with-a-long-random-string
FLOW_MAX_LEVERAGE=5
FLOW_LOW_RISK_PCT=0.35
FLOW_BASE_RISK_PCT=0.50
FLOW_HIGH_RISK_PCT=0.60
FLOW_MAX_OPEN_POSITIONS=3
FLOW_PORTFOLIO_RISK_PCT=1.20
FLOW_SIGNAL_THRESHOLD=86
FLOW_MIN_READY_RATIO=0.50
FLOW_MAX_SPREAD_BPS=10
FLOW_COOLDOWN_SECONDS=900
FLOW_REVERSAL_INTERVAL_SECONDS=60
# Omit FLOW_SYMBOLS for the 30-candidate default.
MAKER_FEE_RATE=0.0006
TAKER_FEE_RATE=0.0008
MIN_SLIPPAGE_BPS=0.5
IMPACT_SLIPPAGE_BPS=8
DAILY_STOP_PCT=2
MONTHLY_STOP_PCT=8
STARTUP_WARMUP_SECONDS=300
REGIME_CONFIRM_SECONDS=180
LIQUIDATION_MIN_NOTIONAL=50000
LIQUIDATION_MIN_EVENTS=5
LIQUIDATION_MIN_VOLUME_RATIO=0.005
ENABLE_BINANCE=true
LOG_LEVEL=INFO
