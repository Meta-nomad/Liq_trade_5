# live = public MEXC/Bybit/Binance feeds; synthetic = deterministic offline demo
DATA_MODE=live
PAPER_BALANCE=1000
# Remove SYMBOLS in Railway to use the 30-candidate default.

# Mount a Railway persistent volume at /data.
DB_PATH=/data/paper_v040.db
RAILWAY_RUN_UID=0
DASHBOARD_TOKEN=replace-with-a-long-random-string

# Conservative configurable execution costs.
MAKER_FEE_RATE=0.0006
TAKER_FEE_RATE=0.0008
MIN_SLIPPAGE_BPS=0.5
IMPACT_SLIPPAGE_BPS=8.0

# One composite portfolio.
COMPOSITE_LOW_RISK_PCT=0.35
COMPOSITE_BASE_RISK_PCT=0.50
COMPOSITE_HIGH_RISK_PCT=0.60
BASE_MAX_LEVERAGE=5
MAX_OPEN_POSITIONS=2
MAX_MARGIN_UTILIZATION=0.75
MAX_PORTFOLIO_RISK_PCT=1.20

# Hard brakes and signal stability.
DAILY_STOP_PCT=2
MONTHLY_STOP_PCT=8
RISK_REDUCTION_DRAWDOWN_PCT=10
SIGNAL_THRESHOLD=86
HIGH_CONVICTION_THRESHOLD=90
STARTUP_WARMUP_SECONDS=300
REGIME_CONFIRM_SECONDS=180
MIN_READY_RATIO=0.80
MAX_ENTRY_SPREAD_BPS=10
COOLDOWN_SECONDS=900

ENABLE_BINANCE=true
LOG_LEVEL=INFO

HIGH_LEVERAGE_LAB=true
LIQUIDATION_MIN_NOTIONAL=50000
LIQUIDATION_MIN_EVENTS=5
LIQUIDATION_MIN_VOLUME_RATIO=0.005
REVERSAL_INTERVAL_SECONDS=15
